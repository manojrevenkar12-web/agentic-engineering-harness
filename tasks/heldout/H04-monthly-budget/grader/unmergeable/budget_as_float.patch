@@ -76,6 +76,34 @@ async def check_entitlements(
         )
         if used >= plan.monthly_tokens:
             raise Entitlement(f"monthly token allowance of {plan.monthly_tokens:,} used")
+    limit = await conn.fetchval("SELECT monthly_limit FROM mrp.budgets")
+    # compared with what was billed, never with this request's estimate: a request that starts
+    # below the budget is answered even if it takes the month past it
+    if limit is not None and (spent := float(await month_billed(conn))) >= limit:
+        raise Entitlement(f"the workspace's monthly budget of {limit:.2f} EUR is used ({spent:.8f} billed)")
+
+
+def month_start(now: datetime | None = None) -> datetime:
+    """The start of the current calendar month in UTC."""
+    now = now or datetime.now(UTC)
+    return datetime(now.year, now.month, 1, tzinfo=UTC)
+
+
+async def month_billed(conn: asyncpg.Connection) -> Decimal:
+    """What the workspace has been billed this month (cache hits included); not cost, not estimates."""
+    return await conn.fetchval(
+        "SELECT coalesce(sum(billed_amount), 0) FROM mrp.usage WHERE created_at >= $1", month_start()
+    )
+
+
+async def budget_status(conn: asyncpg.Connection) -> dict:
+    limit = await conn.fetchval("SELECT monthly_limit FROM mrp.budgets")
+    spent = await month_billed(conn)
+    return {
+        "monthly_limit": None if limit is None else f"{limit:.8f}",
+        "spent": f"{spent:.8f}",
+        "month": month_start().strftime("%Y-%m"),
+    }
 
 
