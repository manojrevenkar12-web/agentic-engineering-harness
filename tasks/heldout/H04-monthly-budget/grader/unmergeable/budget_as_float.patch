diff --git a/src/mrp/sql/002_budgets.sql b/src/mrp/sql/002_budgets.sql
new file mode 100644
index 0000000..7d5e699
--- /dev/null
+++ b/src/mrp/sql/002_budgets.sql
@@ -0,0 +1,16 @@
+-- Monthly spend budgets, set by each workspace for itself. Workspace data: row-level security like
+-- every other workspace table.
+
+CREATE TABLE IF NOT EXISTS mrp.budgets (
+  workspace_id   uuid PRIMARY KEY REFERENCES mrp.workspaces(id),
+  monthly_limit  double precision NOT NULL CHECK (monthly_limit > 0),   -- EUR
+  updated_at     timestamptz NOT NULL DEFAULT now()
+);
+
+ALTER TABLE mrp.budgets ENABLE ROW LEVEL SECURITY;
+DROP POLICY IF EXISTS tenant ON mrp.budgets;
+CREATE POLICY tenant ON mrp.budgets
+  USING (workspace_id = nullif(current_setting('app.workspace_id', true), '')::uuid)
+  WITH CHECK (workspace_id = nullif(current_setting('app.workspace_id', true), '')::uuid);
+
+GRANT SELECT, INSERT, UPDATE, DELETE ON mrp.budgets TO mrp_app;
