+    async def cancel(self, workspace_id: uuid.UUID, run_id: uuid.UUID) -> None:
+        """Cancels a run that has not ended. Raises LookupError when the workspace has no such run
+        and ValueError when the run has already ended."""
+        async with self.db.tenant(workspace_id) as conn:
+            status = await conn.fetchval("SELECT status FROM mrp.agent_runs WHERE id = $1 FOR UPDATE", run_id)
+            if status is None:
+                raise LookupError("no such run")
+            if status not in ("queued", "running", "waiting_approval"):
+                raise ValueError(f"the run has already ended ({status})")
+            await conn.execute(
+                "UPDATE mrp.agent_runs SET status = 'cancelled', updated_at = now() WHERE id = $1", run_id
+            )
